# SABER configuration placeholders ONLY. Never commit real values.
SABER_ENV=dev                       # dev | lab   (lab fails closed without isolation proof + approvals)
SABER_TELEMETRY_BACKEND=fake        # fake | opensearch (opensearch adapter is BLOCKED_INTEGRATION in dev)
SABER_RESPONSE_MODE=dry-run         # dry-run | approved-lab
SABER_MODEL_PROVIDER=stub           # stub | anthropic | gemini   (anthropic/gemini are paid; both fail closed by default)
SABER_DATABASE_URL=sqlite:///./.saber-dev.sqlite3   # dev default; PostgreSQL URL in lab
SABER_RUNS_DIR=./runs
# ANTHROPIC_API_KEY=                # never set here; inject via secret manager if a real provider is approved

# --- Gemini key-pool adapter (PAID; OFF by default) ------------------------------------------
# Billable calls happen ONLY when the operator sets BOTH of the next two. The agent never does.
# SABER_ENABLE_PAID_LLM=1           # explicit opt-in to a paid LLM backend
# SABER_GEMINI_BUDGET_CALLS=0       # hard cap on billable calls; must be >0 to run (BudgetExceeded past it)
# SABER_GEMINI_KEY_POOL=keys_pool.txt   # gitignored file, one API key per line (never commit keys)
# SABER_GEMINI_MODEL=gemini-2.5-flash
