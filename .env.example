# SABER configuration placeholders ONLY. Never commit real values.
SABER_ENV=dev                       # dev | lab   (lab fails closed without isolation proof + approvals)
SABER_TELEMETRY_BACKEND=fake        # fake | opensearch (opensearch adapter is BLOCKED_INTEGRATION in dev)
SABER_RESPONSE_MODE=dry-run         # dry-run | approved-lab
SABER_MODEL_PROVIDER=stub           # stub | anthropic   (anthropic needs ANTHROPIC_API_KEY injected by operator)
SABER_DATABASE_URL=sqlite:///./.saber-dev.sqlite3   # dev default; PostgreSQL URL in lab
SABER_RUNS_DIR=./runs
# ANTHROPIC_API_KEY=                # never set here; inject via secret manager if a real provider is approved
