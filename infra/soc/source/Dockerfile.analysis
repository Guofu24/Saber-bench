FROM ghcr.io/astral-sh/uv:0.9.5 AS uv
FROM eclipse-temurin:21-jdk-jammy AS java
FROM python:3.12.12-slim-bookworm
COPY --from=uv /uv /bin/uv
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends tshark suricata && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app
RUN uv sync --frozen --no-dev --extra analysis && mkdir /data && chown 10001:10001 /data
ENV PATH="/app/.venv/bin:/opt/java/openjdk/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
